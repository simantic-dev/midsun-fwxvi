+
+// TEMP SHOT HOOK (reverted after the run): active only with TELEMETRY_SHOT_DIR. Captures each
+// tab twice, ~60 s apart, so the PNGs show values changing.
+const VIEWS: [&str; 5] = ["signal-table", "dashboard", "cells", "fota", "settings"];
+
+fn tab_of(i: usize) -> Tab {
+    match i {
+        0 => Tab::SignalTable,
+        1 => Tab::Dashboard,
+        2 => Tab::Cells,
+        3 => Tab::Fota,
+        _ => Tab::Settings,
+    }
+}
+
+struct ShotHook {
+    dir:     PathBuf,
+    t0:      Option<std::time::Instant>,
+    plan:    Vec<(f64, usize, bool)>, // (secs since connect, view index, capture now)
+    next:    usize,
+    count:   usize,
+    pending: Option<PathBuf>,
+}
+
+impl ShotHook {
+    fn from_env() -> Option<Self> {
+        let dir = PathBuf::from(std::env::var_os("TELEMETRY_SHOT_DIR")?);
+        std::fs::create_dir_all(&dir).ok()?;
+        let mut plan = Vec::new();
+        for base in [20.0, 80.0] {
+            for view in 0..VIEWS.len() {
+                let t = base + view as f64 * 4.0;
+                plan.push((t, view, false)); // select the tab
+                plan.push((t + 2.0, view, true)); // then capture it
+            }
+        }
+        Some(Self { dir, t0: None, plan, next: 0, count: 0, pending: None })
+    }
+}
+
+impl TelemetryApp {
+    fn shots_tick(&mut self, ctx: &egui::Context) {
+        let Some(mut h) = self.shot.take() else { return };
+        let images: Vec<std::sync::Arc<egui::ColorImage>> = ctx.input(|i| {
+            i.events.iter().filter_map(|e| match e {
+                egui::Event::Screenshot { image, .. } => Some(image.clone()),
+                _ => None,
+            }).collect()
+        });
+        for img in &images {
+            if let Some(path) = h.pending.take() {
+                let raw: Vec<u8> = img.pixels.iter().flat_map(|p| p.to_array()).collect();
+                let [w, hgt] = img.size;
+                if let Err(e) = image::save_buffer(&path, &raw, w as u32, hgt as u32, image::ColorType::Rgba8) {
+                    eprintln!("shot: {}: {e}", path.display());
+                }
+            }
+        }
+        let secs = h.t0.get_or_insert_with(std::time::Instant::now).elapsed().as_secs_f64();
+        if h.pending.is_none() {
+            while let Some(&(at, view, capture)) = h.plan.get(h.next) {
+                if at > secs { break; }
+                h.next += 1;
+                if capture {
+                    h.count += 1;
+                    h.pending = Some(h.dir.join(format!("{:02}-{}.png", h.count, VIEWS[view])));
+                    ctx.send_viewport_cmd(egui::ViewportCommand::Screenshot);
+                    break;
+                }
+                self.active_tab = tab_of(view);
+            }
+        }
+        if h.next >= h.plan.len() && h.pending.is_none() {
+            ctx.send_viewport_cmd(egui::ViewportCommand::Close);
+        } else {
+            ctx.request_repaint_after(std::time::Duration::from_millis(100));
+        }
+        self.shot = Some(h);
     }
 }

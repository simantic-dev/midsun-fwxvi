#!/bin/sh
# Balances a simulated 36-cell pack with the real rear_controller (BMS) firmware.
# Usage: ./demo build   (once: builds the firmware with scons into .venv/ and build/)
#        ./demo [virtual-seconds]   (default 120; needs `sim` on PATH or SIM=/path/to/sim)
cd "$(dirname "$0")" && exec sim/run.sh "${1:-120}"
